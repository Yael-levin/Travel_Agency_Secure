<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 70vh;">

    <div class="card shadow-sm p-4 auth-card">
        <h2 class="text-center mb-4 text-danger">Vulnerable Login</h2>

        <p class="text-muted text-center small">
            SQL Injection demo page for Classwork 2
        </p>

        <form method="post" asp-action="VulnerableLogin" asp-controller="Users">

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="text"
                       name="email"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>

                <div class="input-group">
                    <input type="text"
                           name="password"
                           class="form-control"
                           required />
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="text-danger text-center mb-3">
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn btn-danger w-100 mt-2">
                Login with Vulnerable Query
            </button>
        </form>
    </div>
</div>